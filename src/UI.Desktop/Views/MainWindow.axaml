<suki:SukiWindow xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:vm="using:TowerFluffy.UI.Desktop.ViewModels"
            xmlns:controls="using:TowerFluffy.UI.Desktop.Controls"
            xmlns:conv="using:TowerFluffy.UI.Desktop.Converters"
            xmlns:suki="using:SukiUI.Controls"
            xmlns:theme="using:SukiUI.Theme"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
            x:Class="TowerFluffy.UI.Desktop.Views.MainWindow"
            x:DataType="vm:MainWindowViewModel"
            Background="Transparent"
            MinWidth="1000" MinHeight="700"
            WindowStartupLocation="CenterScreen"
            Title="TowerFluffy">

    <Window.Resources>
        <conv:ReadyToColorConverter x:Key="ReadyToColorConverter" />
        <conv:TowerTypeToBrushConverter x:Key="TowerTypeToBrushConverter" />
        <SolidColorBrush x:Key="AccentBrush" Color="#00A3FF" />
        <SolidColorBrush x:Key="BorderBrush" Color="#1F242E" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#6B7280" />
    </Window.Resources>

    <Grid>
        <suki:SukiBackground />
        <!-- LOBBY PRINCIPAL : EXPANSIF -->
        <Border IsVisible="{Binding IsConnectionVisible}" Padding="60,40">
            <Grid RowDefinitions="Auto, *">
                
                <!-- TITRE (Largeur totale) -->
                <StackPanel Grid.Row="0" Margin="0,0,0,50">
                    <Viewbox Height="50" Stretch="Uniform" HorizontalAlignment="Center">
                        <TextBlock FontSize="40" FontWeight="Black" LetterSpacing="2">
                            <Run Text="TOWER" Foreground="White" />
                            <Run Text=" FLUFFY" Foreground="{StaticResource AccentBrush}" />
                        </TextBlock>
                    </Viewbox>
                    <Rectangle Height="1" Fill="{StaticResource AccentBrush}" Opacity="0.3" Margin="0,20" />
                </StackPanel>

                <!-- GRILLE DE CONTENU (Occupe toute la largeur) -->
                <Grid Grid.Row="1" ColumnDefinitions="2*, 450" ColumnSpacing="60">
                    
                    <!-- GAUCHE : LISTE DES SALLES OU ÉQUILIBRAGE (S'étend) -->
                    <Grid Grid.Column="0">
                        <!-- PANEL 1 : PARTIES EN LIGNE -->
                        <suki:GlassCard CornerRadius="12" Padding="0" IsVisible="{Binding !IsBalancingMenuVisible}">
                            <Grid RowDefinitions="Auto, *">
                                <Border Grid.Row="0" BorderBrush="#20FFFFFF" BorderThickness="0,0,0,1" Padding="25,15" Background="#0AFFFFFF" CornerRadius="12,12,0,0">
                                    <StackPanel Spacing="5" HorizontalAlignment="Center">
                                        <TextBlock Text="PARTIES EN LIGNE" FontSize="16" FontWeight="Bold" LetterSpacing="2" Foreground="White" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding ServerUrl, StringFormat='{}Serveur : {0}'}" FontSize="11" Foreground="#80FFFFFF" HorizontalAlignment="Center" IsVisible="{Binding IsConnected}" />
                                    </StackPanel>
                                </Border>
                                
                                <Grid Grid.Row="1">
                                    <ListBox ItemsSource="{Binding AvailableGames}" Background="Transparent" BorderThickness="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="25,20">
                                                    <Grid ColumnDefinitions="*, Auto">
                                                        <StackPanel Spacing="5">
                                                            <TextBlock Text="{Binding GameId}" FontWeight="Bold" FontSize="18" />
                                                            <StackPanel Orientation="Horizontal" Spacing="20">
                                                                <TextBlock Text="{Binding PlayerCount, StringFormat='{}{0} / 2 joueurs'}" FontSize="13" Foreground="White" />
                                                                <TextBlock Text="• Disponible" Foreground="#10B981" FontSize="13" IsVisible="{Binding !IsStarted}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="REJOINDRE" Classes="Flat" Height="45" Padding="30,0"
                                                                Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).JoinSpecificGameCommand}" 
                                                                CommandParameter="{Binding GameId}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    
                                    <StackPanel IsVisible="{Binding !IsConnected}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="25" Width="400">
                                        <TextBlock Text="CONNEXION RÉSEAU TACTIQUE" FontWeight="Bold" FontSize="15" Foreground="White" HorizontalAlignment="Center" LetterSpacing="2" />
                                        
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Adresse du serveur :" FontSize="11" Foreground="#A0FFFFFF" FontWeight="Bold" />
                                            <TextBox Text="{Binding ServerUrl}" Watermark="http://192.168.X.X:5128/gameHub" Height="45" Background="#0D0F14" Foreground="White" />
                                        </StackPanel>
                                        
                                        <Button Command="{Binding ConnectCommand}" Content="SE CONNECTER" Classes="Flat" Height="45" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsEnabled="{Binding !IsConnecting}" />
                                        
                                        <ProgressBar IsVisible="{Binding IsConnecting}" IsIndeterminate="True" Height="2" Foreground="{StaticResource AccentBrush}" Margin="0,5,0,0" />
                                        
                                        <TextBlock IsVisible="{Binding LastError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" 
                                                   Text="{Binding LastError}" Foreground="#FF3B30" FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </suki:GlassCard>

                        <!-- PANEL 2 : MENU D'ÉQUILIBRAGE TACTIQUE -->
                        <suki:GlassCard CornerRadius="12" Padding="0" IsVisible="{Binding IsBalancingMenuVisible}">
                            <Grid RowDefinitions="Auto, *">
                                <Border Grid.Row="0" BorderBrush="#20FFFFFF" BorderThickness="0,0,0,1" Padding="25,15" Background="#0AFFFFFF" CornerRadius="12,12,0,0">
                                    <StackPanel Spacing="5" HorizontalAlignment="Center">
                                        <TextBlock Text="RÉGLAGES D'ÉQUILIBRAGE (SOLO)" FontSize="16" FontWeight="Bold" LetterSpacing="2" Foreground="White" HorizontalAlignment="Center" />
                                        <TextBlock Text="Configurez les statistiques des troupes et des défenses locales" FontSize="11" Foreground="#80FFFFFF" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <Grid Grid.Row="1" RowDefinitions="*, Auto" Margin="30,25">
                                    <!-- CONTENU DES DEUX COLONNES (TOURS & UNITÉS) -->
                                    <Grid Grid.Row="0" ColumnDefinitions="*, *" ColumnSpacing="40">
                                        <!-- COLONNE GAUCHE : TOURS -->
                                        <StackPanel Spacing="15">
                                            <TextBlock Text="🎯 STATS DES TOURS" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,5" />
                                            
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="Sélectionner une tour :" FontSize="11" Foreground="#A0FFFFFF" FontWeight="Bold" />
                                                <ComboBox SelectedIndex="{Binding SelectedBalancingTowerIndex}" HorizontalAlignment="Stretch" Height="40" Background="#0D0F14">
                                                    <ComboBoxItem>Mitrailleuse Standard</ComboBoxItem>
                                                    <ComboBoxItem>Lance-flammes tactique</ComboBoxItem>
                                                    <ComboBoxItem>Sniper lourd</ComboBoxItem>
                                                    <ComboBoxItem>Canon de défense</ComboBoxItem>
                                                    <ComboBoxItem>Laser continu</ComboBoxItem>
                                                </ComboBox>
                                            </StackPanel>

                                            <StackPanel Spacing="15">
                                                <!-- Coût -->
                                                <StackPanel Spacing="6">
                                                    <Grid ColumnDefinitions="*, Auto">
                                                        <TextBlock Text="Coût de construction :" FontSize="12" Foreground="White" />
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                                            <TextBlock Text="{Binding BalancingTowerCost}" FontSize="12" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" />
                                                            <TextBlock Text="CR" FontSize="10" Foreground="#80FFFFFF" VerticalAlignment="Bottom" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <Slider Minimum="10" Maximum="800" Value="{Binding BalancingTowerCost}" SmallChange="5" LargeChange="50" TickFrequency="5" IsSnapToTickEnabled="True" />
                                                </StackPanel>

                                                <!-- Dégâts -->
                                                <StackPanel Spacing="6">
                                                    <Grid ColumnDefinitions="*, Auto">
                                                        <TextBlock Text="Dégâts par tir :" FontSize="12" Foreground="White" />
                                                        <TextBlock Grid.Column="1" Text="{Binding BalancingTowerDamage}" FontSize="12" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" />
                                                    </Grid>
                                                    <Slider Minimum="1" Maximum="200" Value="{Binding BalancingTowerDamage}" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True" />
                                                </StackPanel>

                                                <!-- Portée -->
                                                <StackPanel Spacing="6">
                                                    <Grid ColumnDefinitions="*, Auto">
                                                        <TextBlock Text="Portée d'attaque (pixels) :" FontSize="12" Foreground="White" />
                                                        <TextBlock Grid.Column="1" Text="{Binding BalancingTowerRange}" FontSize="12" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" />
                                                    </Grid>
                                                    <Slider Minimum="50" Maximum="600" Value="{Binding BalancingTowerRange}" SmallChange="10" LargeChange="50" TickFrequency="10" IsSnapToTickEnabled="True" />
                                                </StackPanel>

                                                <!-- Cooldown -->
                                                <StackPanel Spacing="6">
                                                    <Grid ColumnDefinitions="*, Auto">
                                                        <TextBlock Text="Vitesse (Délai en ticks entre tirs) :" FontSize="12" Foreground="White" />
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                                            <TextBlock Text="{Binding BalancingTowerCooldown}" FontSize="12" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" />
                                                            <TextBlock Text="ticks" FontSize="10" Foreground="#80FFFFFF" VerticalAlignment="Bottom" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <Slider Minimum="2" Maximum="150" Value="{Binding BalancingTowerCooldown}" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- COLONNE DROITE : UNITÉS -->
                                        <StackPanel Grid.Column="1" Spacing="15">
                                            <TextBlock Text="👾 STATS DES UNITÉS" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,5" />
                                            
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="Sélectionner une unité :" FontSize="11" Foreground="#A0FFFFFF" FontWeight="Bold" />
                                                <ComboBox SelectedIndex="{Binding SelectedBalancingUnitIndex}" HorizontalAlignment="Stretch" Height="40" Background="#0D0F14">
                                                    <ComboBoxItem>Soldat d'assaut</ComboBoxItem>
                                                    <ComboBoxItem>Brute lourde</ComboBoxItem>
                                                    <ComboBoxItem>Éclaireur rapide</ComboBoxItem>
                                                    <ComboBoxItem>Tireur d'élite</ComboBoxItem>
                                                    <ComboBoxItem>Tank blindé</ComboBoxItem>
                                                </ComboBox>
                                            </StackPanel>

                                            <StackPanel Spacing="15">
                                                <!-- Coût -->
                                                <StackPanel Spacing="6">
                                                    <Grid ColumnDefinitions="*, Auto">
                                                        <TextBlock Text="Coût d'invocation :" FontSize="12" Foreground="White" />
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                                            <TextBlock Text="{Binding BalancingUnitCost}" FontSize="12" Foreground="#EF4444" FontWeight="Bold" />
                                                            <TextBlock Text="CR" FontSize="10" Foreground="#80FFFFFF" VerticalAlignment="Bottom" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <Slider Minimum="5" Maximum="500" Value="{Binding BalancingUnitCost}" SmallChange="5" LargeChange="20" TickFrequency="5" IsSnapToTickEnabled="True" />
                                                </StackPanel>

                                                <!-- PV -->
                                                <StackPanel Spacing="6">
                                                    <Grid ColumnDefinitions="*, Auto">
                                                        <TextBlock Text="Points de vie maximum :" FontSize="12" Foreground="White" />
                                                        <TextBlock Grid.Column="1" Text="{Binding BalancingUnitHealth}" FontSize="12" Foreground="#EF4444" FontWeight="Bold" />
                                                    </Grid>
                                                    <Slider Minimum="5" Maximum="1000" Value="{Binding BalancingUnitHealth}" SmallChange="5" LargeChange="50" TickFrequency="5" IsSnapToTickEnabled="True" />
                                                </StackPanel>

                                                <!-- Vitesse -->
                                                <StackPanel Spacing="6">
                                                    <Grid ColumnDefinitions="*, Auto">
                                                        <TextBlock Text="Vitesse de déplacement (pixels/tick) :" FontSize="12" Foreground="White" />
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                                            <TextBlock Text="{Binding BalancingUnitSpeed}" FontSize="12" Foreground="#EF4444" FontWeight="Bold" />
                                                            <TextBlock Text="px/tick" FontSize="10" Foreground="#80FFFFFF" VerticalAlignment="Bottom" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <Slider Minimum="1" Maximum="10" Value="{Binding BalancingUnitSpeed}" SmallChange="1" LargeChange="2" TickFrequency="1" IsSnapToTickEnabled="True" />
                                                </StackPanel>

                                                <!-- Bounty -->
                                                <StackPanel Spacing="6">
                                                    <Grid ColumnDefinitions="*, Auto">
                                                        <TextBlock Text="Récompense de mort (Butin) :" FontSize="12" Foreground="White" />
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                                            <TextBlock Text="{Binding BalancingUnitBounty}" FontSize="12" Foreground="#EF4444" FontWeight="Bold" />
                                                            <TextBlock Text="CR" FontSize="10" Foreground="#80FFFFFF" VerticalAlignment="Bottom" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <Slider Minimum="1" Maximum="200" Value="{Binding BalancingUnitBounty}" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <!-- ZONE BASSE : PROPOSITIONS D'ÉQUILIBRAGE DE BASE -->
                                    <Border Grid.Row="1" Background="#10FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,15,0,0">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="💡 Propositions d'équilibrage par défaut appliquées :" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock Text="• Sniper nerf : Coût ajusté à 200 CR (au lieu de 150) et recharge à 75 ticks (au lieu de 60) pour limiter sa domination." FontSize="11" Foreground="#C0FFFFFF" TextWrapping="Wrap" />
                                            <TextBlock Text="• Économie saine : Butins d'unités (Bounties) réduits à 30-40% de leur coût pour éviter d'inonder le défenseur de crédits et rendre le jeu stratégique." FontSize="11" Foreground="#C0FFFFFF" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </suki:GlassCard>
                    </Grid>

                    <!-- DROITE : OPTIONS (Largeur fixe de 450 pour rester propre) -->
                    <StackPanel Grid.Column="1" Spacing="40" VerticalAlignment="Top">
                        <suki:GlassCard CornerRadius="12" Padding="30">
                            <StackPanel Spacing="25">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Rôle Tactique" FontWeight="Bold" FontSize="14" Foreground="White" />
                                    <ComboBox SelectedIndex="{Binding SelectedRole}" HorizontalAlignment="Stretch" Height="45" Background="#0D0F14">
                                        <ComboBoxItem>Mode Entraînement (Solo)</ComboBoxItem>
                                        <ComboBoxItem>Unité d'Assaut (Attaquant)</ComboBoxItem>
                                        <ComboBoxItem>Unité de Défense (Défenseur)</ComboBoxItem>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Spacing="12" IsVisible="{Binding IsSoloMode}">
                                    <TextBlock Text="Options Avancées" FontWeight="Bold" FontSize="14" Foreground="White" />
                                    <ToggleSwitch IsChecked="{Binding IsBalancingMenuVisible}" Content="Réglages d'équilibrage" Foreground="White" OffContent="Masqués" OnContent="Affichés" />
                                </StackPanel>

                                <StackPanel Spacing="12" IsVisible="{Binding !IsSoloMode}">
                                    <TextBlock Text="Nouvelle Opération" FontWeight="Bold" FontSize="14" Foreground="White" />
                                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="15">
                                        <TextBox x:Name="RoomName" Watermark="Nom de la salle..." Height="45" Background="#0D0F14" />
                                        <Button Grid.Column="1" Content="CRÉER" Command="{Binding JoinSpecificGameCommand}" CommandParameter="{Binding #RoomName.Text}" Classes="Flat" Height="45" Padding="25,0" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </suki:GlassCard>

                        <Button IsVisible="{Binding IsSoloMode}" Command="{Binding StartSoloCommand}" 
                                Classes="Flat" Background="{StaticResource AccentBrush}" Foreground="White" 
                                Height="70" HorizontalAlignment="Stretch" CornerRadius="12">
                            <TextBlock Text="DÉPLOYER" FontWeight="Black" FontSize="20" LetterSpacing="5" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- SALLE D'ATTENTE : PLEIN ÉCRAN -->
        <Border IsVisible="{Binding IsWaitingRoomVisible}" ZIndex="250">
            <!-- Arrière-plan stylisé -->
            <Border.Background>
                <RadialGradientBrush Center="50%,50%" GradientOrigin="50%,50%" RadiusX="150%" RadiusY="150%">
                    <GradientStop Color="#F0050814" Offset="0" />
                    <GradientStop Color="#FF020306" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>
            
            <Grid VerticalAlignment="Center" HorizontalAlignment="Stretch" MaxWidth="1100">
                <StackPanel Spacing="70">
                    
                    <!-- EN-TÊTE -->
                    <StackPanel Spacing="15">
                        <TextBlock Text="S É Q U E N C E   D ' I N I T I A L I S A T I O N" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" LetterSpacing="3"/>
                        <TextBlock Text="PRÉPARATION DE LA MISSION" Foreground="White" FontSize="48" FontWeight="Black" LetterSpacing="10" HorizontalAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#4169E1" BlurRadius="20" Opacity="0.5" OffsetX="0" OffsetY="0" />
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="{Binding ServerUrl, StringFormat='{}Réseau Connecté : {0}'}" Foreground="#80FFFFFF" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" LetterSpacing="2"/>
                        
                        <Border Height="2" Width="400" HorizontalAlignment="Center" Margin="0,10,0,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                    <GradientStop Color="#004169E1" Offset="0"/>
                                    <GradientStop Color="#FF4169E1" Offset="0.5"/>
                                    <GradientStop Color="#004169E1" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </StackPanel>
                    
                    <!-- CARTES DE JOUEURS -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="60" Margin="40,0">
                        
                        <!-- JOUEUR -->
                        <suki:GlassCard Grid.Column="0" CornerRadius="20" Padding="0" BorderBrush="{Binding IsReady, Converter={StaticResource ReadyToColorConverter}}" BorderThickness="3">
                            <Grid RowDefinitions="Auto, *">
                                <Border Grid.Row="0" Background="#15FFFFFF" Padding="20">
                                    <TextBlock Text="VOTRE SYSTÈME" HorizontalAlignment="Center" Foreground="White" FontSize="18" FontWeight="Bold" LetterSpacing="3" />
                                </Border>
                                
                                <StackPanel Grid.Row="1" Spacing="30" Margin="40" VerticalAlignment="Center">
                                    <ToggleButton IsChecked="{Binding IsReady}" HorizontalAlignment="Center" 
                                                  Width="280" Height="80" CornerRadius="12"
                                                  BorderBrush="{Binding IsReady, Converter={StaticResource ReadyToColorConverter}}"
                                                  BorderThickness="2" Cursor="Hand">
                                        <TextBlock Text="{Binding IsReady, Converter={StaticResource ReadyToColorConverter}, ConverterParameter=StatusText}" 
                                                   Foreground="{Binding IsReady, Converter={StaticResource ReadyToColorConverter}}"
                                                   FontSize="24" FontWeight="Black" LetterSpacing="4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </ToggleButton>
                                    <TextBlock Text="CLIQUEZ POUR CHANGER DE STATUT" Foreground="White" FontSize="12" HorizontalAlignment="Center" LetterSpacing="2" />
                                </StackPanel>
                            </Grid>
                        </suki:GlassCard>

                        <!-- ADVERSAIRE -->
                        <suki:GlassCard Grid.Column="1" CornerRadius="20" Padding="0" BorderBrush="{Binding IsOpponentReady, Converter={StaticResource ReadyToColorConverter}}" BorderThickness="3">
                            <Grid RowDefinitions="Auto, *">
                                <Border Grid.Row="0" Background="#15FFFFFF" Padding="20">
                                    <TextBlock Text="RÉSEAU ADVERSE" HorizontalAlignment="Center" Foreground="White" FontSize="18" FontWeight="Bold" LetterSpacing="3" />
                                </Border>
                                
                                <StackPanel Grid.Row="1" Spacing="30" Margin="40" VerticalAlignment="Center">
                                    <Border Width="280" Height="80" CornerRadius="12" BorderThickness="2"
                                            BorderBrush="{Binding IsOpponentReady, Converter={StaticResource ReadyToColorConverter}}">
                                        <Border.Background>
                                            <SolidColorBrush Color="#15FFFFFF" />
                                        </Border.Background>
                                        <TextBlock Text="{Binding IsOpponentReady, Converter={StaticResource ReadyToColorConverter}, ConverterParameter=StatusText}" 
                                                   Foreground="{Binding IsOpponentReady, Converter={StaticResource ReadyToColorConverter}}"
                                                   FontSize="24" FontWeight="Black" LetterSpacing="4"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="EN ATTENTE DE SYNCHRONISATION..." Foreground="White" FontSize="12" HorizontalAlignment="Center" LetterSpacing="2" />
                                </StackPanel>
                            </Grid>
                        </suki:GlassCard>

                    </Grid>
                    
                    <!-- BOUTON D'ANNULATION -->
                    <Button Command="{Binding ReplayCommand}" 
                            Classes="Basic" Foreground="#FF3B30"
                            HorizontalAlignment="Center" Margin="0,30,0,0" Cursor="Hand">
                        <TextBlock Text="ANNULER LA MISSION" FontSize="16" FontWeight="Black" LetterSpacing="3" />
                    </Button>
                    
                </StackPanel>
            </Grid>
        </Border>

        <!-- HUD EN JEU : OPTIMISÉ POUR LE LARGE -->
        <Grid IsVisible="{Binding IsGameStarted}" RowDefinitions="Auto, *, Auto" Margin="40">
            
            <suki:GlassCard Grid.Row="0" CornerRadius="16" Padding="30,15" Margin="0,0,0,20">
                <Grid ColumnDefinitions="*, Auto, *">
                    <!-- GAUCHE : TITRE -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="TOWER" FontWeight="Black" FontSize="20" Foreground="White" LetterSpacing="2"/>
                        <TextBlock Text="FLUFFY" FontWeight="Black" FontSize="20" Foreground="{StaticResource AccentBrush}" LetterSpacing="2"/>
                        <Border Background="#20FFFFFF" CornerRadius="6" Padding="10,4" Margin="15,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="TACTIQUE" FontWeight="Bold" FontSize="11" Foreground="White" LetterSpacing="2"/>
                        </Border>
                    </StackPanel>
                    
                    <!-- CENTRE : STATISTIQUES (SANTÉ & VAGUE) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="50">
                        <!-- SANTÉ -->
                        <StackPanel HorizontalAlignment="Center" Spacing="2">
                            <TextBlock Text="INTÉGRITÉ BASE" FontSize="11" Foreground="#A0FFFFFF" FontWeight="Bold" LetterSpacing="1" HorizontalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                <TextBlock Text="{Binding BaseHealth}" FontSize="36" FontWeight="Black" Foreground="White" />
                                <TextBlock Text="PV" FontSize="14" FontWeight="Bold" Foreground="#60FFFFFF" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
                            </StackPanel>
                        </StackPanel>
                        
                        <!-- SÉPARATEUR -->
                        <Rectangle Width="2" Fill="#20FFFFFF" Margin="0,10" RadiusX="1" RadiusY="1" />
                        
                        <!-- VAGUE -->
                        <StackPanel HorizontalAlignment="Center" Spacing="2">
                            <TextBlock Text="VAGUE EN COURS" FontSize="11" Foreground="#A0FFFFFF" FontWeight="Bold" LetterSpacing="1" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding WaveNumber}" FontSize="36" FontWeight="Black" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                    
                    <!-- DROITE : BOUTON ABANDONNER -->
                    <Button Grid.Column="2" Command="{Binding ReplayCommand}" 
                            Background="#15FF3B30" BorderBrush="#50FF3B30" BorderThickness="1" CornerRadius="8" 
                            Padding="25,12" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand">
                        <TextBlock Text="ABANDONNER" Foreground="#FF3B30" FontWeight="Bold" FontSize="13" LetterSpacing="2" />
                    </Button>
                </Grid>
            </suki:GlassCard>

            <Grid Grid.Row="1" ColumnDefinitions="*">
                <Viewbox Stretch="Uniform" Margin="20,0">
                    <controls:GameBoardControl x:Name="Board"
                                               Snapshot="{Binding Snapshot}" 
                                               PlaceTowerCommand="{Binding PlaceTowerCommand}" 
                                               SellTowerCommand="{Binding SellTowerCommand}"
                                               SelectedTowerType="{Binding CurrentTowerType}"
                                               IsPlacementMode="{Binding CanPlaceTower}" />
                </Viewbox>
            </Grid>

            <!-- DASHBOARD TACTIQUE UNIFIÉ EN BAS -->
            <suki:GlassCard Grid.Row="2" CornerRadius="16" Padding="25,15" Margin="0,15,0,0">
                <Grid RowDefinitions="Auto, Auto" RowSpacing="15">
                    
                    <!-- LIGNE 1 : INFOS DE MISSION & RESSOURCES -->
                    <Grid Grid.Row="0" ColumnDefinitions="*, *, *">
                        <!-- GAUCHE : NIVEAU & CHRONO -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="15" VerticalAlignment="Center">
                            <Border Background="#1AFFFFFF" CornerRadius="6" Padding="12,6" BorderBrush="#30FFFFFF" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="NIVEAU" FontSize="11" FontWeight="Bold" Foreground="#A0FFFFFF" LetterSpacing="2" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Level}" FontSize="16" FontWeight="Black" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#20FFFFFF" CornerRadius="8" Padding="12,6" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ActivePhaseLabel}" FontWeight="Bold" FontSize="12" Foreground="White" LetterSpacing="1" />
                            </Border>
                            <TextBlock Text="{Binding ActivePhaseTime}" FontSize="24" FontWeight="Black" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        
                        <!-- CENTRE : CRÉDITS (CR) -->
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- DEFENDER GOLD -->
                            <Border Background="#1A00A3FF" CornerRadius="8" Padding="20,6" BorderBrush="#4000A3FF" BorderThickness="1" IsVisible="{Binding CanPlaceTower}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="CRÉDITS DÉFENSE :" FontSize="11" FontWeight="Bold" Foreground="#A000A3FF" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding DefenderGold, StringFormat='{}{0} CR'}" FontSize="18" FontWeight="Black" Foreground="White" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <!-- ATTACKER BUDGET -->
                            <Border Background="#1AEF4444" CornerRadius="8" Padding="20,6" BorderBrush="#40EF4444" BorderThickness="1" IsVisible="{Binding CanSendUnits}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="BUDGET ATTAQUE :" FontSize="11" FontWeight="Bold" Foreground="#A0EF4444" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding AttackerBudget, StringFormat='{}{0} CR'}" FontSize="18" FontWeight="Black" Foreground="White" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- DROITE : BOUTON VAGUE SUIVANTE -->
                        <Button Grid.Column="2" Command="{Binding SkipPreparationCommand}" 
                                IsVisible="{Binding IsSkipButtonVisible}" 
                                Background="#1A4169E1" BorderBrush="#504169E1" BorderThickness="1" CornerRadius="8"
                                Padding="20,10" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand">
                            <TextBlock Text="VAGUE SUIVANTE" Foreground="#6A98FF" FontWeight="Bold" FontSize="12" LetterSpacing="2" />
                        </Button>
                    </Grid>

                    <!-- LIGNE 2 : BARRE DE SORTS / BOUTIQUE COMPACTE -->
                    <Grid Grid.Row="1" HorizontalAlignment="Center">
                        
                        <!-- BOUTIQUE DÉFENSE (Tours) -->
                        <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsDefenderShopVisible}">
                            <Button Command="{Binding SetBasicTowerCommand}" Background="{Binding CurrentTowerType, Converter={StaticResource TowerTypeToBrushConverter}, ConverterParameter=BasicShooter}" Height="40" Padding="15,0" CornerRadius="6" Cursor="Hand" BorderBrush="#30FFFFFF" BorderThickness="1">
                                <TextBlock Text="{Binding BasicTowerCost, StringFormat='[1] STANDARD ({0} CR)'}" FontWeight="Bold" FontSize="11" Foreground="White" />
                            </Button>
                            <Button Command="{Binding SetFlamethrowerCommand}" Background="{Binding CurrentTowerType, Converter={StaticResource TowerTypeToBrushConverter}, ConverterParameter=Flamethrower}" Height="40" Padding="15,0" CornerRadius="6" Cursor="Hand" BorderBrush="#30FFFFFF" BorderThickness="1">
                                <TextBlock Text="{Binding FlamethrowerCost, StringFormat='[2] FLAMMES ({0} CR)'}" FontWeight="Bold" FontSize="11" Foreground="White" />
                            </Button>
                            <Button Command="{Binding SetSniperTowerCommand}" Background="{Binding CurrentTowerType, Converter={StaticResource TowerTypeToBrushConverter}, ConverterParameter=Sniper}" Height="40" Padding="15,0" CornerRadius="6" Cursor="Hand" BorderBrush="#30FFFFFF" BorderThickness="1">
                                <TextBlock Text="{Binding SniperTowerCost, StringFormat='[3] SNIPER ({0} CR)'}" FontWeight="Bold" FontSize="11" Foreground="White" />
                            </Button>
                            <Button Command="{Binding SetCannonTowerCommand}" Background="{Binding CurrentTowerType, Converter={StaticResource TowerTypeToBrushConverter}, ConverterParameter=Cannon}" Height="40" Padding="15,0" CornerRadius="6" Cursor="Hand" BorderBrush="#30FFFFFF" BorderThickness="1">
                                <TextBlock Text="{Binding CannonTowerCost, StringFormat='[4] CANON ({0} CR)'}" FontWeight="Bold" FontSize="11" Foreground="White" />
                            </Button>
                            <Button Command="{Binding SetLaserTowerCommand}" Background="{Binding CurrentTowerType, Converter={StaticResource TowerTypeToBrushConverter}, ConverterParameter=Laser}" Height="40" Padding="15,0" CornerRadius="6" Cursor="Hand" BorderBrush="#30FFFFFF" BorderThickness="1">
                                <TextBlock Text="{Binding LaserTowerCost, StringFormat='[5] LASER ({0} CR)'}" FontWeight="Bold" FontSize="11" Foreground="White" />
                            </Button>
                        </StackPanel>

                        <!-- BOUTIQUE ATTAQUE (Unités) -->
                        <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsAttackerShopVisible}">
                            <Button Command="{Binding SendSoldatCommand}" Background="#1AEF4444" BorderBrush="#40EF4444" BorderThickness="1" Height="40" Padding="15,0" CornerRadius="6" Cursor="Hand">
                                <TextBlock Text="{Binding SoldatCost, StringFormat='SOLDAT ({0} CR)'}" FontWeight="Bold" FontSize="11" Foreground="White" />
                            </Button>
                            <Button Command="{Binding SendRapideCommand}" Background="#1AEF4444" BorderBrush="#40EF4444" BorderThickness="1" Height="40" Padding="15,0" CornerRadius="6" Cursor="Hand">
                                <TextBlock Text="{Binding RapideCost, StringFormat='RAPIDE ({0} CR)'}" FontWeight="Bold" FontSize="11" Foreground="White" />
                            </Button>
                            <Button Command="{Binding SendTireurEliteCommand}" Background="#1AEF4444" BorderBrush="#40EF4444" BorderThickness="1" Height="40" Padding="15,0" CornerRadius="6" Cursor="Hand">
                                <TextBlock Text="{Binding TireurEliteCost, StringFormat='ÉLITE ({0} CR)'}" FontWeight="Bold" FontSize="11" Foreground="White" />
                            </Button>
                            <Button Command="{Binding SendBruteCommand}" Background="#1AEF4444" BorderBrush="#40EF4444" BorderThickness="1" Height="40" Padding="15,0" CornerRadius="6" Cursor="Hand">
                                <TextBlock Text="{Binding BruteCost, StringFormat='BRUTE ({0} CR)'}" FontWeight="Bold" FontSize="11" Foreground="White" />
                            </Button>
                            <Button Command="{Binding SendTankCommand}" Background="#1AEF4444" BorderBrush="#40EF4444" BorderThickness="1" Height="40" Padding="15,0" CornerRadius="6" Cursor="Hand">
                                <TextBlock Text="{Binding TankCost, StringFormat='TANK ({0} CR)'}" FontWeight="Bold" FontSize="11" Foreground="White" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </suki:GlassCard>
        </Grid>

        <!-- OVERLAY DE FIN DE PARTIE -->
        <Border IsVisible="{Binding IsGameFinished}" ZIndex="300">
            <Border.Background>
                <SolidColorBrush Color="#E6050814" />
            </Border.Background>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="40">
                <TextBlock Text="FIN DE MISSION" Foreground="White" FontSize="20" FontWeight="Bold" LetterSpacing="5" HorizontalAlignment="Center" Opacity="0.7" />
                
                <TextBlock Text="{Binding GameResultMessage}" Foreground="{Binding GameResultColor}" FontSize="56" FontWeight="Black" LetterSpacing="3" HorizontalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="{Binding GameResultColor}" BlurRadius="30" Opacity="0.4" OffsetX="0" OffsetY="0" />
                    </TextBlock.Effect>
                </TextBlock>

                <StackPanel Orientation="Horizontal" Spacing="30" HorizontalAlignment="Center" Margin="0,30,0,0">
                    <Button Command="{Binding ReplayCommand}" 
                            Classes="Flat" Background="{StaticResource AccentBrush}" Foreground="White" 
                            Height="60" Padding="40,0" CornerRadius="12" Cursor="Hand">
                        <TextBlock Text="REJOUER (MENU)" FontWeight="Black" FontSize="18" LetterSpacing="2" />
                    </Button>
                    <Button Command="{Binding QuitCommand}" 
                            Background="#1AFFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1" Foreground="White" 
                            Height="60" Padding="40,0" CornerRadius="12" Cursor="Hand">
                        <TextBlock Text="QUITTER" FontWeight="Bold" FontSize="18" LetterSpacing="2" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

    </Grid>
</suki:SukiWindow>
